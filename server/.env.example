# Copy to .env and fill in. .env is gitignored and not baked into the image.

# --- Storage ---
# SQLAlchemy database URL. Defaults to a local SQLite file; point it at Postgres
# or MySQL to use those instead (install the matching driver extra first, e.g.
# `uv sync --extra postgres`).
#   sqlite:///usage.db
#   postgresql://user:password@host/dbname
#   mysql+pymysql://user:password@host/dbname
DATABASE_URL=sqlite:///usage.db

# --- Login providers (configure Entra, Google, or both) ---
# At least one must be set, or the login endpoints return 503. The sign-in
# screen shows a button only for each provider that is configured. Users are
# keyed by email, so the same address works across providers.

# Microsoft Entra ID (Azure AD): create an app registration in the Azure
# portal, add the redirect URI below as a "Web" platform redirect, and
# generate a client secret.
ENTRA_TENANT_ID=
ENTRA_CLIENT_ID=
ENTRA_CLIENT_SECRET=
ENTRA_REDIRECT_URI=http://localhost:8000/api/auth/microsoft/callback

# Google: create an OAuth 2.0 Client ID (type "Web application") in the Google
# Cloud console and add the redirect URI below as an authorized redirect URI.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/api/auth/google/callback

# Where the browser lands after a successful login (the SPA).
FRONTEND_URL=/

# --- Sessions ---
# Signs the session cookie (and the JWT it carries). Use a long random string
# in production; if unset a random one is generated per process (sessions drop
# on restart). Generate one with: python -c "import secrets; print(secrets.token_hex(32))"
SESSION_SECRET=

# Comma-separated browser origins allowed to call the API with credentials.
# Include the Vite dev server for local development.
CORS_ORIGINS=http://localhost:5173,http://localhost:8000

# --- Environment ---
# production (default) or development. development enables the /api/auth/login
# shortcut. Admin is a per-user flag, not configured here — grant it with:
#   uv run python -m scripts.set_admin <email>
ENVIRONMENT=production
